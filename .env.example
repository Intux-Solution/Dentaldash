# ============================================================
# Variables de entorno - DentalDash
# ============================================================
# Copiar este archivo como .env y completar los valores reales.
# NUNCA commitear el .env con valores reales al repositorio.
# ============================================================

# ── Supabase (Frontend) ─────────────────────────────────────
VITE_SUPABASE_URL=https://<proyecto>.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Supabase Edge Functions Secrets ─────────────────────────
# Configurar en: Supabase Dashboard > Project Settings > Edge Functions > Secrets
#
# SUPABASE_URL          (auto-provisto por Supabase, no hace falta agregar)
# SUPABASE_SERVICE_ROLE_KEY  (auto-provisto por Supabase, no hace falta agregar)

# ── MercadoPago ──────────────────────────────────────────────
# Obtener en: https://www.mercadopago.com.ar/developers/panel/app
# Crear aplicacion > Credenciales de produccion
MP_ACCESS_TOKEN=APP_USR-0000000000000000-000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-000000000
MP_PUBLIC_KEY=APP_USR-00000000-0000-0000-0000-000000000000

# Secreto para validar la firma de webhooks de MercadoPago
# Generarlo en: MercadoPago Developers > Tu app > Webhooks > Clave secreta
MP_WEBHOOK_SECRET=tu_secreto_webhook_aqui

# ── URLs de la aplicacion ───────────────────────────────────
# URL publica del frontend (sin trailing slash)
APP_URL=https://tu-dominio.com

# ── Integraciones existentes ────────────────────────────────
EVOLUTION_API_URL=https://tu-evolution-api.com
EVOLUTION_API_KEY=tu_api_key_evolution

OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AIza...

GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# ============================================================
# PASOS PARA CONFIGURAR SECRETS EN SUPABASE EDGE FUNCTIONS:
#
# 1. Ir a Supabase Dashboard > Project Settings > Edge Functions
# 2. En "Secrets" agregar cada variable con su valor real:
#    - MP_ACCESS_TOKEN
#    - MP_PUBLIC_KEY
#    - MP_WEBHOOK_SECRET
#    - APP_URL
#
# O via Supabase CLI:
#   supabase secrets set MP_ACCESS_TOKEN=APP_USR-...
#   supabase secrets set MP_PUBLIC_KEY=APP_USR-...
#   supabase secrets set MP_WEBHOOK_SECRET=...
#   supabase secrets set APP_URL=https://tu-dominio.com
# ============================================================
